            "url": { "raw": "{{base_url}}/api/listing?id=LISTING_ID", "host": ["{{base_url}}"], "path": ["api","listing"], "query": [{ "key": "id", "value": "LISTING_ID" }] }
          }
        },
        {
          "name": "Top Listings",
          "request": {
            "method": "GET",
