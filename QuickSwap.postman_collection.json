            "body": { "mode": "raw", "raw": "{\n  \"title\": \"Vintage Camera\",\n  \"subtitle\": \"Canon AE-1\",\n  \"description\": \"Great condition vintage film camera\",\n  \"category\": \"Electronics\",\n  \"subcategory\": \"Cameras\",\n  \"condition\": \"Good\",\n  \"brand\": \"Canon\",\n  \"color\": \"Black\",\n  \"size\": \"Medium\",\n  \"images\": [\"https://example.com/img1.jpg\"],\n  \"starting_bid\": 50.00,\n  \"buy_now_price\": 150.00,\n  \"auction_start_time\": \"2026-04-10T10:00:00Z\",\n  \"auction_end_time\": \"2026-04-17T10:00:00Z\",\n  \"location\": \"Chennai, India\",\n  \"notes\": \"No scratches\"\n}" }
          }
